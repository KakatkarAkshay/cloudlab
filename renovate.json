{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesWeekly",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "flux": {
    "managerFilePatterns": [
      "kubernetes/**/*.yaml",
      "kubernetes/**/*.yml"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "kubernetes/**/*.yaml",
      "kubernetes/**/*.yml"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "**/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "flux",
        "kubernetes"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchFileNames": [
        "kubernetes/clusters/*/*.yaml"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ghcr.io/soju06/charts/codex-lb",
        "ghcr.io/soju06/codex-lb"
      ],
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "matchCurrentVersion": "/-(alpha|beta|rc|pre)/",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "ignoreUnstable": false,
      "allowedVersions": "/^v?[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$/"
    },
    {
      "matchManagers": [
        "custom.jsonata"
      ],
      "matchFileNames": [
        "cluster-versions.json"
      ],
      "groupName": "talos + kubernetes",
      "separateMultipleMinor": true
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "kubernetes/clusters/*/*.yaml"
      ],
      "matchStrings": [
        "$[kind = 'GitRepository' and $exists(spec.ref.tag)].{'depName': $substringBefore($substringAfter(spec.url, 'https://github.com/'), '.git'), 'currentValue': spec.ref.tag, 'currentDigest': spec.ref.commit}"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "cluster-versions.json"
      ],
      "matchStrings": [
        "{'depName': 'siderolabs/talos', 'currentValue': talos}"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "cluster-versions.json"
      ],
      "matchStrings": [
        "{'depName': 'siderolabs/kubelet', 'currentValue': kubernetes}"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/siderolabs/kubelet",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "terraform/infra/variables.tf"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/renovate.yml"
      ],
      "matchStrings": [
        "renovate-version: (?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker"
    }
  ]
}
